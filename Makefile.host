CXX ?= c++
CXXFLAGS ?= -std=c++17 -Wall -Wextra -Werror -pedantic -O2

HOST_BUILD := .build-host
CORE_SOURCES := \
	source/core/engine.cpp \
	source/core/locale.cpp \
	source/core/size.cpp \
	source/generated/messages.cpp
TEST_BINARY := $(HOST_BUILD)/core-tests
DAMAGE_TEST_BINARY := $(HOST_BUILD)/damage-tests
CATALOG_TEST_BINARY := $(HOST_BUILD)/catalog-tests
SWITCH_TEST_BINARY := $(HOST_BUILD)/switch-adapter-tests
SETTINGS_TEST_BINARY := $(HOST_BUILD)/settings-tests

.PHONY: test clean-host

test: $(TEST_BINARY) $(DAMAGE_TEST_BINARY) $(CATALOG_TEST_BINARY) \
		$(SWITCH_TEST_BINARY) \
		$(SETTINGS_TEST_BINARY)
	@$(TEST_BINARY)
	@$(DAMAGE_TEST_BINARY)
	@$(CATALOG_TEST_BINARY)
	@$(SWITCH_TEST_BINARY)
	@$(SETTINGS_TEST_BINARY)

$(TEST_BINARY): $(CORE_SOURCES) tests/core_tests.cpp
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude $(CORE_SOURCES) tests/core_tests.cpp -o $@

$(DAMAGE_TEST_BINARY): source/core/damage.cpp tests/damage_tests.cpp
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude $^ -o $@

$(CATALOG_TEST_BINARY): source/core/locale.cpp source/generated/catalog.cpp \
		source/generated/messages.cpp tests/catalog_tests.cpp
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude $^ -o $@

$(SWITCH_TEST_BINARY): source/generated/catalog.cpp \
		source/generated/messages.cpp \
		source/generated/switch_aliases.cpp \
		source/core/damage.cpp \
		source/core/engine.cpp \
		source/core/locale.cpp \
		source/core/size.cpp \
		source/platform/switch/dmnt_memory.cpp \
		source/platform/switch/game_patches.cpp \
		source/platform/switch/game_profile.cpp \
		source/platform/switch/game_session.cpp \
		source/platform/switch/language.cpp \
		source/platform/switch/monster_reader.cpp \
		source/platform/switch/patch_baseline.cpp \
		tests/switch_adapter_tests.cpp
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude $^ -o $@

$(SETTINGS_TEST_BINARY): source/app/settings.cpp tests/settings_tests.cpp
	@mkdir -p $(HOST_BUILD)
	$(CXX) $(CXXFLAGS) -Iinclude $^ -o $@

clean-host:
	rm -rf $(HOST_BUILD)
