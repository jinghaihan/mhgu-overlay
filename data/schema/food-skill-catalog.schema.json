{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MHGU/MHXX food skill catalog",
  "type": "object",
  "required": ["sources", "skills"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "skills": {
      "type": "array",
      "minItems": 65,
      "maxItems": 65,
      "items": {
        "type": "object",
        "required": ["id", "key"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65
          },
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
