{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MHGU overlay locale",
  "type": "object",
  "required": ["locale", "ui", "monsters"],
  "properties": {
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z]{2,8})*$"
    },
    "ui": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "monsters": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true
}
